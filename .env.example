# Copy to .env and fill in credentials. This file is documentation, not runnable defaults.
TELEGRAM_BOT_TOKEN=
# Owner username, for example @NotRshia; matching ignores case and @ is optional.
TELEGRAM_ALLOWED_USERNAME=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Caption generation uses text only. Never commit the API key.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Optional channel publisher; activate explicitly using /platforms after configuration.
TELEGRAM_CHANNEL_ID=
# Optional: needed only to reconcile historical Upload-Post requests.
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=

# Native account credentials: keep these writable and outside version control.
YOUTUBE_CREDENTIALS_FILE=./data/youtube-credentials.json
YOUTUBE_CLIENT_SECRETS_FILE=./data/youtube-client-secret.json
YOUTUBE_PRIVACY_STATUS=private

# Required declarations: explicitly set each to true or false for your videos.
YOUTUBE_MADE_FOR_KIDS=
YOUTUBE_CONTAINS_SYNTHETIC_MEDIA=
YOUTUBE_PAID_PRODUCT_PLACEMENT=
# Writable credential file containing the native TikTok app credentials and OAuth tokens.
# New TikTok posts use video.publish; historical inbox attempts retain video.upload.
TIKTOK_CREDENTIALS_FILE=./data/tiktok-credentials.json
# disabled | private_test | approved. "approved" requires an actually audited eligible app.
TIKTOK_DIRECT_MODE=disabled
# Set true only after verifying PUBLIC_SITE_URL's /publisher/media/ prefix in TikTok.
TIKTOK_MEDIA_VERIFIED=false
WEB_BIND=127.0.0.1
WEB_PORT=8080

# Docker defaults; change paths/URL only when running outside Compose.
TELEGRAM_API_URL=http://telegram-bot-api:8081
TELEGRAM_FILES_DIRECTORY=/var/lib/telegram-bot-api
DATA_DIRECTORY=./data
MAX_VIDEO_BYTES=2000000000
DISK_RESERVE_BYTES=2000000000
MEDIA_RETENTION_HOURS=72
MAX_PENDING_JOBS=100

# Public website and optional TikTok Mini App/media endpoint (HTTPS origin, no path).
PUBLIC_SITE_URL=https://upload.al-rowads.com
